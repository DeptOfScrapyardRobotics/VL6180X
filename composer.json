{
    "name": "dept-of-scrapyard-robotics/vl6180x",
    "description": "Drive VL6180X time-of-flight range sensors over I2C with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "vl6180x",
        "time-of-flight",
        "tof",
        "range",
        "i2c",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.8.0",
        "gpio/integrated-circuits": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "gpio/digital": "^0.8.0",
        "gpio/i2c": "^0.8.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.8.0",
        "venusian-voyager/vessel": "^0.8.0"
    },
    "suggest": {
        "gpio/digital": "^0.8.0 - GPIO1 interrupt and XSHUT pins",
        "gpio/i2c": "^0.8.0 - I2C connections for VL6180XI2CTransport",
        "microscrap/scrapyard-linux": "^0.8.0 - native i2c-dev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.8.0 - MPSSE I2C and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\VL6180X\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\VL6180X\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Sensors\\VL6180X\\Providers\\VL6180XServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/scrapyard-io/framework/src/GeneralPurposeIO/*",
            "options": {
                "symlink": true,
                "versions": {
                    "gpio/contracts": "0.8.0",
                    "gpio/digital": "0.8.0",
                    "gpio/i2c": "0.8.0",
                    "gpio/integrated-circuits": "0.8.0",
                    "gpio/nuts-and-bolts": "0.8.0",
                    "gpio/pwm": "0.8.0",
                    "gpio/spi": "0.8.0",
                    "gpio/uart": "0.8.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/framework/src/Voyager/*",
            "options": {
                "symlink": true,
                "versions": {
                    "venusian-voyager/collections": "0.8.8",
                    "venusian-voyager/conditionable": "0.8.8",
                    "venusian-voyager/config": "0.8.8",
                    "venusian-voyager/contracts": "0.8.8",
                    "venusian-voyager/io-pools": "0.8.8",
                    "venusian-voyager/macroable": "0.8.8",
                    "venusian-voyager/magic-aliases": "0.8.8",
                    "venusian-voyager/nuts-and-bolts": "0.8.8",
                    "venusian-voyager/reflection": "0.8.8",
                    "venusian-voyager/vessel": "0.8.8"
                }
            }
        }
    ]
}
